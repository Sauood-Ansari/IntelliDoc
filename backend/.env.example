ENVIRONMENT=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/intellidoc
# Generate a random key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set a persistent key before running multiple workers or deploying.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
